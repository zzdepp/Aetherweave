{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "password": { "type": "string" },
        "avatar": { "type": "string", "maxLength": 10 },
        "bio": { "type": "string", "maxLength": 500 },
        "following": { "type": "array" },
        "followers": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "email"]
    },
    "Post": {
      "title": "Community Post",
      "description": "A post submitted to Aetherweave",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "author": { "type": "string", "maxLength": 50 },
        "handle": { "type": "string", "maxLength": 60 },
        "avatar": { "type": "string", "maxLength": 10 },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 5000 },
        "space": { "type": "string", "maxLength": 50 },
        "images": { "type": "array" },
        "votes": { "type": "number" },
        "upvoters": { "type": "array" },
        "downvoters": { "type": "array" },
        "comments": { "type": "array" },
        "saved": { "type": "array" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "title", "body", "author"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered user accounts"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Community discussion posts"
    }
  }
}
